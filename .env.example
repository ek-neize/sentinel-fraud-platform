# Copy to .env and fill in. .env is gitignored — never commit real values.
KAFKA_BOOTSTRAP=pkc-xxxxx.us-east-1.aws.confluent.cloud:9092
KAFKA_PRODUCER_KEY=
KAFKA_PRODUCER_SECRET=
# The Databricks consumer key/secret live in the Databricks secret scope "sentinel",
# not here.

# --- Optional: email the daily alert digest (scripts/send_digest.py) ---
# Gmail: enable 2-Step Verification, then create an App Password
# (Google Account > Security > App passwords) and paste the 16-character code.
ALERT_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
ALERT_EMAIL_TO=you@gmail.com

# --- Optional: investigation assistant (scripts/evaluate_assistant.py, generate_briefs.py) ---
# Create a key at console.anthropic.com > API keys. Never commit or paste it anywhere else.
ANTHROPIC_API_KEY=
